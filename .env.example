# Скопируй в .env и подставь свои значения:
#   cp .env.example .env
#
# Загрузка (если нужно):
#   set -a && source .env && set +a
#   # или: export $(grep -v '^#' .env | xargs)

# --- LLM proxy (обязательно для ReAct / calibrate) ---
# NeuralDeep: https://api.neuraldeep.ru/v1  (ключ sk-... из кабинета hub.neuraldeep.ru)
# Не ставь invite-ссылку hub.neuraldeep.ru/?invite=... — это не API base.
LLM_BASE_URL=https://api.neuraldeep.ru/v1
LLM_API_KEY=sk-your-key-here
LLM_PROVIDER=OpenAI
LLM_SSL_VERIFY=false

# Proxy model (contest allow-list). Default: qwen3.8-27b-noreason
# Alternatives: qwen3.8-27b, qwen3.6-35b-a3b, qwen3.6-35b-a3b-noreason
LLM_MODEL=qwen3.8-27b-noreason

# --- HuggingFace Hub (опционально, для scripts/build_external_datasets.py) ---
# https://huggingface.co/settings/tokens — read token достаточно
HF_TOKEN=

# --- Запуск харнесса ---
# Каталог с задачами (альтернатива флагу --tasks-dir)
TASKS=./task_packs/test-100

# Куда писать cost_journal.jsonl (файл или директория)
OUT=./out

# Мягкий потолок бюджета в output-token units (пример жюри: 100000)
BUDGET=100000

# Параллельность сессий (1..5). Держи 1–2, иначе proxy часто отдаёт 429.
MAX_WORKERS=2
